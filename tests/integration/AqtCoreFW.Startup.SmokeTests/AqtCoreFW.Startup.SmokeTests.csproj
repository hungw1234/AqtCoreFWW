<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>AqtCoreFW.Startup.SmokeTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <!-- Host + shared test fixtures (WebAppFixture, SqlServerFixture, TestAuthHandler) -->
    <ProjectReference Include="../../../src/host/AqtCoreFW.Api/AqtCoreFW.Api.csproj" />
    <!-- AuthServer host — referenced for AuthServerHostFixture (relocated from AuthServer.Tests).
         Safe to coexist with Api host because both Program classes are namespaced
         (AqtCoreFW.Api.Program vs AqtCoreFW.AuthServer.Program). -->
    <ProjectReference Include="../../../src/host/AqtCoreFW.AuthServer/AqtCoreFW.AuthServer.csproj" />
    <ProjectReference Include="../../shared/AqtCoreFW.Tests.SharedFixtures/AqtCoreFW.Tests.SharedFixtures.csproj" />
  </ItemGroup>
</Project>
