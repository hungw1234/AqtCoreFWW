    <ProjectReference Include="..\AqtCoreFW.SharedKernel\AqtCoreFW.SharedKernel.csproj" />
    <ProjectReference Include="..\AqtCoreFW.SharedKernel.Contracts\AqtCoreFW.SharedKernel.Contracts.csproj" />
    <!-- OrgUnit contract + DTOs consumed by the shared-Infra HttpOrgUnitModuleClient. Leaf edge:
         OrgUnit.Contracts has no ProjectReferences, so this introduces no cycle. -->
    <ProjectReference Include="..\AqtCoreFW.OrgUnit.Contracts\AqtCoreFW.OrgUnit.Contracts.csproj" />
    <!-- IAlertEmailSender consumed by Alerting/AlertEvaluationJob. Leaf edge: Notification.Contracts
         has no ProjectReferences, so this introduces no cycle even though Notifications.Infrastructure
         (which implements the interface) references this project. -->
    <ProjectReference Include="..\AqtCoreFW.Notification.Contracts\AqtCoreFW.Notification.Contracts.csproj" />
  </ItemGroup>
</Project>
