<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AqtCoreFW.SharedKernel.Contracts</AssemblyName>
    <RootNamespace>AqtCoreFW.SharedKernel.Contracts</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>AqtCoreFW.SharedKernel.Contracts</PackageId>
    <Version>1.0.0</Version>
    <Description>AqtCoreFW cross-module client interfaces + integration events. Used as project reference in monolith, NuGet when microservices extracted.</Description>
  </PropertyGroup>
  <!--
    The I*Client interfaces in Clients/ remain pure C# — zero PackageReferences, zero
    ProjectReferences beyond this one. Events/ is different: an integration event that must
    route through the Outbox (atomic, at-least-once) has to implement SharedKernel's
    IExternalDomainEvent marker so OutboxInterceptor/IOutboxWriter can capture it — hence the
    ProjectReference below. This is a deliberate, accepted trade: at microservice-extraction
    time, Events/ ships as the messaging-contracts NuGet (naturally carrying this marker,
    since MassTransit/outbox-based delivery is the whole point of an integration event); the
    Clients/ interfaces would extract as a separate, still-dependency-free RPC-contracts
    package if that split is ever needed.
  -->
  <ItemGroup>
    <ProjectReference Include="..\AqtCoreFW.SharedKernel\AqtCoreFW.SharedKernel.csproj" />
  </ItemGroup>
</Project>
