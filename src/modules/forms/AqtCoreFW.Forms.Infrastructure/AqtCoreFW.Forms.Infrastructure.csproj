  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NCalcSync" />
    <PackageReference Include="QuestPDF" />
    <ProjectReference Include="..\AqtCoreFW.Forms.Application\AqtCoreFW.Forms.Application.csproj" />
    <ProjectReference Include="..\..\..\shared\AqtCoreFW.Infrastructure\AqtCoreFW.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\shared\AqtCoreFW.Forms.Contracts\AqtCoreFW.Forms.Contracts.csproj" />
  </ItemGroup>
</Project>
