    <AssemblyName>AqtCoreFW.Forms.Infrastructure</AssemblyName>
    <RootNamespace>AqtCoreFW.Forms.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cascade v1: expose internal pure helpers (BuildRequestUrl/BuildCacheKey/ApplyParentFilter)
         to the unit-test assembly so cascade filter semantics are testable without HTTP/reflection. -->
