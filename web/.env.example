# Copy to .env.local and fill in values (scripts/1_run-local-dev.ps1 creates it automatically)
# Local dev (default, dotnet run): API=5001, AuthServer=5002
# Docker dev (full compose stack): API=5001 (nginx), AuthServer=5000 -> set VITE_OIDC_AUTHORITY=http://localhost:5000
VITE_APP_NAME=AqtCoreFW
VITE_APP_SUBTITLE=Hệ thống quản trị - Khung CNTT Chính phủ
VITE_APP_LOGO_URL=
VITE_API_BASE_URL=http://localhost:5001
VITE_OIDC_AUTHORITY=http://localhost:5002
VITE_AUTH_CLIENT_ID=aqtcorefw-spa-dev
