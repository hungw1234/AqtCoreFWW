# Copy to infra/docker/.env to override compose defaults (compose reads .env next to docker-compose.yml).
# Host port for the AuthServer. Default 5000; on macOS port 5000 is held by AirPlay Receiver
# (System Settings > General > AirDrop & Handoff), so pick another free port, e.g. 5100.
# Rebuild the web image after changing it: docker compose up -d --build
AUTH_PORT=5000
